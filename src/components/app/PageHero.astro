---
interface Props {
  kicker: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="page-hero">
  <span class="page-hero__kicker">{kicker}</span>
  <h1 class="page-hero__title">{title}</h1>
  {lede && <p class="page-hero__lede">{lede}</p>}
  {Astro.slots.has("default") && (
    <div class="page-hero__slot">
      <slot />
    </div>
  )}
</header>

<style>
  .page-hero {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .page-hero__kicker {
    display: block;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .page-hero__title {
    margin: 0.35rem 0 0;
    max-width: 26ch;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.4rem);
    font-weight: 680;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
    color: var(--text);
  }

  .page-hero__lede {
    margin: 0.6rem 0 0;
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .page-hero__slot {
    margin-top: 1rem;
    max-width: 42rem;
    display: grid;
    gap: 0.6rem;
  }

  .page-hero__slot :global([data-slot="alert"]) {
    padding: 0.7rem 0.9rem;
    font-size: 0.875rem;
    line-height: 1.5;
    border-radius: var(--radius);
    border-color: var(--hairline);
    background: var(--surface-2);
    color: var(--text);
  }

  @media (min-width: 640px) {
    .page-hero__lede {
      font-size: 1rem;
    }
  }
</style>
