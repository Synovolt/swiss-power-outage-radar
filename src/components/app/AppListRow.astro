---
import type { HTMLAttributes } from "astro/types";
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";

interface Props extends HTMLAttributes<"a"> {
  title: string;
  description?: string;
  kicker?: string;
}

const { title, description, kicker, class: className, href, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={["app-list-row", className]}
  role="listitem"
  {...rest}
>
  <span class="app-list-row__content">
    {kicker && <span class="app-list-row__kicker">{kicker}</span>}
    <span class="app-list-row__title">{title}</span>
    {description && <span class="app-list-row__desc">{description}</span>}
  </span>
  <span class="app-list-row__chevron">
    <ChevronRight class="size-4" aria-hidden="true" />
  </span>
</a>

<style>
  .app-list-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--hairline);
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .app-list-row:last-child {
    border-bottom: 0;
  }

  .app-list-row:hover,
  .app-list-row:focus-visible {
    background: var(--surface-2);
  }

  .app-list-row:focus-visible {
    outline-offset: -2px;
  }

  .app-list-row__content {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .app-list-row__kicker {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .app-list-row__title {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    line-height: 1.35;
  }

  .app-list-row__desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .app-list-row__chevron {
    flex-shrink: 0;
    color: var(--text-faint);
    transition: transform var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .app-list-row:hover .app-list-row__chevron,
  .app-list-row:focus-visible .app-list-row__chevron {
    transform: translateX(2px);
    color: var(--text);
  }
</style>
