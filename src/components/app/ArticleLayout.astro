---
import { t, type AppLocale } from "../../i18n";

interface Link {
  href: string;
  label: string;
}

interface Props {
  links?: Link[];
  locale?: AppLocale;
}

const { links = [], locale = "de" } = Astro.props;
const tocNav = t(locale, "article.tocNav");
const tocLabel = t(locale, "article.tocLabel");
---

<div class="article-layout">
  {links.length > 0 && (
    <nav class="article-toc-mobile" aria-label={tocNav}>
      <p class="article-toc-mobile__label">{tocLabel}</p>
      <div class="article-toc-mobile__scroller">
        {links.map((link) => (
          <a href={link.href} class="article-toc-chip">
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  )}

  <div class="article-layout__grid">
    {links.length > 0 && (
      <nav class="article-toc-desktop" aria-label={tocNav}>
        <p class="article-toc-desktop__label">{tocLabel}</p>
        {links.map((link) => (
          <a href={link.href} class="article-toc-desktop__link">
            {link.label}
          </a>
        ))}
      </nav>
    )}
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</div>

<style>
  .article-layout {
    display: grid;
    gap: 1rem;
  }

  .article-toc-mobile {
    display: grid;
    gap: 0.4rem;
  }

  .article-toc-mobile__label {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .article-toc-mobile__scroller {
    display: flex;
    gap: 0.375rem;
    overflow-x: auto;
    margin-inline: -1rem;
    padding: 0.05rem 1rem 0.2rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .article-toc-mobile__scroller::-webkit-scrollbar {
    display: none;
  }

  .article-toc-chip {
    flex: none;
    max-width: 14rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
  }

  .article-toc-chip:hover,
  .article-toc-chip:focus-visible {
    border-color: var(--hairline-strong);
    color: var(--text);
  }

  .article-layout__grid {
    display: grid;
    gap: 1.25rem;
  }

  .article-toc-desktop {
    display: none;
  }

  .article-toc-desktop__label {
    margin: 0 0 0.4rem;
    padding-inline-start: 0.75rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .article-toc-desktop__link {
    color: var(--text-muted);
    border-inline-start: 1px solid var(--hairline);
    padding-block: 0.3rem;
    padding-inline-start: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }

  .article-toc-desktop__link:hover,
  .article-toc-desktop__link:focus-visible {
    border-inline-start-color: var(--text);
    color: var(--text);
  }

  @media (min-width: 900px) {
    .article-toc-mobile {
      display: none;
    }

    .article-layout__grid {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }

    .article-toc-desktop {
      position: sticky;
      top: calc(var(--app-top-offset) + 1rem);
      display: grid;
      gap: 0;
      align-self: start;
    }
  }
</style>
