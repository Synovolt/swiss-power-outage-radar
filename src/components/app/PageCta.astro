---
import { Button } from "@/components/starwind/button";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";

interface Props {
  title: string;
  description: string;
  href: string;
  label: string;
}

const { title, description, href, label } = Astro.props;
---

<div class="page-cta">
  <div class="page-cta__copy">
    <span class="page-cta__title">{title}</span>
    <span class="page-cta__desc">{description}</span>
  </div>
  <Button as="a" href={href} variant="primary" size="sm" class="page-cta__btn">
    {label}
    <ArrowRight class="size-4" />
  </Button>
</div>

<style>
  .page-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .page-cta__copy {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .page-cta__title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--text);
  }

  .page-cta__desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .page-cta__btn {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .page-cta {
      flex-direction: column;
      align-items: stretch;
    }

    .page-cta :global(.page-cta__btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
