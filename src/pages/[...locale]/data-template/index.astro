---
/**
 * Shell for Worker-rendered data pages (statistics, places, canton pages).
 * The Worker fills #data-shell and all meta tags via HTMLRewriter; requests
 * for /data-template/ itself are redirected to the home page.
 */
import RadarLayout from "../../../layouts/RadarLayout.astro";
import "../../../styles/data-pages.css";
import { localeFromParam, localeStaticPaths, t, type AppLocale } from "../../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
---

<RadarLayout
  title="outage.ch"
  description={t(locale, "site.description")}
  robots="noindex,follow"
  shell="content"
  locale={locale}
>
  <div id="data-shell" aria-busy="true">
    <div class="dp dp--loading" aria-hidden="true">
      <div class="dp-skel dp-skel--title"></div>
      <div class="dp-skel"></div>
      <div class="dp-skel dp-skel--block"></div>
    </div>
  </div>
</RadarLayout>
