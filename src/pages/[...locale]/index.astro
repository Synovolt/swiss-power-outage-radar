---
/**
 * Radar home: desktop = split map | list (viewport-locked), mobile = map HUD + drawer.
 * The Worker (src/seo-home.ts) fills #radar-list with server-rendered rows and
 * #radar-index with the compact public index; this script then takes over with
 * instant search and filtering over the full index (src/radar-view.ts).
 */
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../../layouts/RadarLayout.astro";
import AppLangSwitch from "@/components/app/AppLangSwitch.astro";
import "../../styles/radar-items.css";
import { homeJsonLd } from "../../seo-site";
import { renderHomeAbout } from "../../seo-home";
import {
  localeFromParam,
  localeStaticPaths,
  pathFor,
  radarViewCopy,
  t,
  type AppLocale
} from "../../i18n";
import { SITE_ORIGIN, absoluteUrl } from "../../public-url";
import { Button } from "@/components/starwind/button";
import { InputGroup, InputGroupAddon, InputGroupInput } from "@/components/starwind/input-group";
import Search from "@tabler/icons/outline/search.svg";
import X from "@tabler/icons/outline/x.svg";
import List from "@tabler/icons/outline/list.svg";
import Refresh from "@tabler/icons/outline/refresh.svg";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
const homePath = pathFor({ kind: "home" }, locale);
const copy = radarViewCopy(locale);
const views = ["now", "planned", "history"] as const;
---

<RadarLayout
  title={t(locale, "data.home.title")}
  description={t(locale, "site.description")}
  canonical={absoluteUrl(homePath, SITE_ORIGIN)}
  robots="index,follow,max-image-preview:large"
  shell="radar"
  activeNav="radar"
  locale={locale}
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />
  <link slot="head" rel="preconnect" href="https://vectortiles.geo.admin.ch" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://vectortiles.geo.admin.ch" />
  <script slot="head" type="application/ld+json" set:html={homeJsonLd(SITE_ORIGIN, locale)} />
  <script id="radar-i18n" type="application/json" set:html={JSON.stringify(copy).replace(/</g, "\\u003c")} />
  <script id="radar-index" type="application/json" set:html="null" />

  <section class="radar" data-radar>
    <div class="radar__map-wrap" data-loading-label={t(locale, "event.mapLoading")}>
      <div id="radar-map" class="radar__map" role="img" aria-label={t(locale, "home.mapAria")}></div>
      <div class="radar__legend" aria-hidden="true">
        <span><i class="legend-shape legend-shape--triangle"></i>{t(locale, "home.legendUnplanned")}</span>
        <span><i class="legend-shape legend-shape--square"></i>{t(locale, "home.legendPlanned")}</span>
        <span><i class="legend-dot" data-tone="active"></i>{t(locale, "home.legendActive")}</span>
        <span><i class="legend-dot" data-tone="upcoming"></i>{t(locale, "home.legendUpcoming")}</span>
        <span><i class="legend-dot" data-tone="resolved"></i>{t(locale, "home.legendResolved")}</span>
      </div>
      <p class="radar__disclaimer">{t(locale, "home.disclaimer")}</p>
    </div>

    <header class="radar__hud">
      <div class="radar__hud-bar">
        <a class="radar__brand" href={homePath} aria-label="outage.ch Radar">outage.ch</a>
        <InputGroup class="radar__search min-w-0">
          <InputGroupAddon>
            <Search class="size-4" aria-hidden="true" />
          </InputGroupAddon>
          <label class="sr-only" for="radar-search">{t(locale, "home.searchLabel")}</label>
          <InputGroupInput
            id="radar-search"
            type="search"
            placeholder={t(locale, "data.radar.searchHint")}
            autocomplete="off"
            enterkeyhint="search"
            aria-keyshortcuts="/"
          />
          <kbd class="radar__kbd" aria-hidden="true">/</kbd>
        </InputGroup>
        <AppLangSwitch locale={locale} class="app-langs--hud" />
      </div>
      <div class="radar__filters">
        <div class="radar__views" role="group" aria-label={t(locale, "data.radar.viewsAria")}>
          {views.map((view) => (
            <button type="button" class="radar-view" data-view={view} aria-pressed={view === "now" ? "true" : "false"}>
              {copy.views[view]}<span class="radar-view__n" data-view-count={view}>–</span>
            </button>
          ))}
        </div>
        <div class="radar__nature" role="group" aria-label={t(locale, "home.filterNature")}>
          <button type="button" class="radar-toggle" data-nature="" aria-pressed="true">{copy.natureAll}</button>
          <button type="button" class="radar-toggle" data-nature="unplanned" aria-pressed="false"><i class="legend-shape legend-shape--triangle" aria-hidden="true"></i>{copy.nature.unplanned}</button>
          <button type="button" class="radar-toggle" data-nature="planned" aria-pressed="false"><i class="legend-shape legend-shape--square" aria-hidden="true"></i>{copy.nature.planned}</button>
        </div>
      </div>
    </header>

    <aside class="radar__panel" id="radar-panel" aria-labelledby="radar-title">
      <div class="radar__handle" aria-hidden="true"></div>
      <div class="radar__panel-head">
        <div class="min-w-0">
          <h1 id="radar-title">{t(locale, "data.home.h1")}</h1>
          <p id="radar-count" class="radar__count" aria-live="polite">{t(locale, "home.loading")}</p>
        </div>
        <div class="radar__panel-actions">
          <Button type="button" id="radar-refresh" variant="ghost" size="icon-sm" aria-label={t(locale, "home.refresh")} title={t(locale, "home.refresh")}>
            <Refresh class="size-4" aria-hidden="true" />
          </Button>
          <Button type="button" id="radar-panel-close" variant="ghost" size="sm" class="radar__panel-close" aria-label={t(locale, "home.closeList")}>{t(locale, "home.close")}</Button>
        </div>
      </div>
      <div class="radar__scroll" id="radar-scroll">
        <div id="radar-list" class="radar__list" aria-busy="true">
          <div class="radar-skel"></div><div class="radar-skel"></div><div class="radar-skel"></div>
        </div>
        <div class="radar__more-wrap">
          <Button type="button" id="radar-more" variant="outline" size="sm" class="w-full" hidden>{t(locale, "home.loadMore")}</Button>
        </div>
        <Fragment set:html={renderHomeAbout(locale)} />
      </div>
      <div class="radar__panel-foot">
        <p id="radar-note" class="radar__note">{t(locale, "home.loading")}</p>
        <p class="radar__foot-disclaimer">{t(locale, "home.disclaimer")}</p>
      </div>
    </aside>

    <div id="radar-sheet" class="radar__sheet" hidden>
      <Button type="button" id="radar-sheet-close" variant="ghost" size="icon-sm" class="radar__sheet-x" aria-label={t(locale, "home.closePreview")}>
        <X class="size-4" />
      </Button>
      <div id="radar-sheet-body"></div>
      <Button as="a" id="radar-sheet-link" href="#" class="mt-3 w-full">{t(locale, "home.openReport")}</Button>
    </div>

    <Button type="button" id="radar-list-fab" class="radar__fab" aria-controls="radar-panel">
      <List class="size-[1.05rem]" aria-hidden="true" />
      {t(locale, "home.reports")}
      <b id="radar-fab-count">–</b>
    </Button>
  </section>

  <script>
    import {
      HISTORY_PAGE,
      countLabel,
      eventHref,
      fromIndex,
      groupItems,
      groupsHtml,
      inView,
      matchesNature,
      matchesQuery,
      rowHtml,
      sortForView,
      toneOf,
      viewCounts,
      type RadarCopy,
      type RadarItem,
      type RadarNature,
      type RadarView
    } from "../../radar-view";
    import { SWISS_CANTONS } from "../../swiss-cantons";

    const copy = JSON.parse(document.querySelector("#radar-i18n")?.textContent || "{}") as RadarCopy;
    const VIEWS: RadarView[] = ["now", "planned", "history"];
    // Each poll is a Worker invocation (100k/day on the free plan): keep it rare.
    const REFRESH_MS = 600_000;

    const params = new URLSearchParams(location.search);
    const initialView = params.get("view") as RadarView | null;
    const initialNature = params.get("type") as RadarNature | null;

    const state = {
      items: [] as RadarItem[],
      generatedAt: null as string | null,
      view: (initialView && VIEWS.includes(initialView) ? initialView : "now") as RadarView,
      nature: (initialNature === "planned" || initialNature === "unplanned" ? initialNature : "") as RadarNature,
      query: params.get("q") ?? "",
      limit: HISTORY_PAGE,
      selectedId: null as number | null,
      drawerOpen: false,
      loading: false,
      error: false,
      /** True while only the embedded "now" subset is loaded. */
      partial: false,
      embeddedCounts: null as Record<RadarView, number> | null
    };

    const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
    const listEl = $<HTMLElement>("#radar-list");
    const scrollEl = $<HTMLElement>("#radar-scroll");
    const countEl = $<HTMLElement>("#radar-count");
    const noteEl = $<HTMLElement>("#radar-note");
    const moreBtn = $<HTMLButtonElement>("#radar-more");
    const searchEl = $<HTMLInputElement>("#radar-search");
    const panelEl = $<HTMLElement>("#radar-panel");
    const sheetEl = $<HTMLElement>("#radar-sheet");
    const sheetBody = $<HTMLElement>("#radar-sheet-body");
    const sheetLink = $<HTMLAnchorElement>("#radar-sheet-link");
    const fabEl = $<HTMLButtonElement>("#radar-list-fab");
    const fabCountEl = $<HTMLElement>("#radar-fab-count");
    const mapWrap = $<HTMLElement>(".radar__map-wrap");
    searchEl.value = state.query;

    const CANTON_CENTROIDS = new Map(SWISS_CANTONS.map((canton) => [canton.code, canton.centroid]));
    const cssVar = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
    const TONE_COLOR = () => ({
      active: cssVar("--status-active", "#cb2a2f"),
      upcoming: cssVar("--status-upcoming", "#b45309"),
      resolved: cssVar("--status-resolved", "#2f7d4f"),
      other: cssVar("--status-archive", "#6b7280")
    });
    let colors = TONE_COLOR();

    const isMobile = () => window.matchMedia("(max-width: 899px)").matches;
    const now = () => Date.now();
    const searching = () => state.query.trim().length > 0;

    function filtered(): RadarItem[] {
      const t = now();
      if (searching()) {
        return sortForView(state.items.filter((item) => matchesNature(item, state.nature) && matchesQuery(item, state.query)), "now");
      }
      return sortForView(state.items.filter((item) => inView(item, state.view, t) && matchesNature(item, state.nature)), state.view);
    }

    function visibleItems(all = filtered()): RadarItem[] {
      return state.view === "history" || searching() ? all.slice(0, state.limit) : all;
    }

    function pinFor(item: RadarItem): [number, number] | null {
      if (typeof item.lat === "number" && typeof item.lon === "number") return [item.lon, item.lat];
      const centroid = item.canton ? CANTON_CENTROIDS.get(item.canton) : null;
      if (!centroid) return null;
      return [centroid[1] + ((item.id % 13) - 6) * 0.012, centroid[0] + ((item.id % 17) - 8) * 0.012];
    }

    function syncUrl() {
      const next = new URLSearchParams();
      if (state.view !== "now") next.set("view", state.view);
      if (state.nature) next.set("type", state.nature);
      if (state.query.trim()) next.set("q", state.query.trim());
      const query = next.toString();
      history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
    }

    // ---------------------------------------------------------------- map
    let map: any = null;
    let maplibregl: any = null;
    let mapReady = false;
    let mapInit: Promise<any> | null = null;
    let lastFitKey = "";

    const markerId = (shape: "triangle" | "square", color: string, selected: boolean) =>
      `pin-${shape}-${color.replace(/[^a-z0-9]/gi, "")}-${selected ? "s" : "n"}`;

    function drawMarker(shape: "triangle" | "square", color: string, selected: boolean) {
      const dpr = 2;
      const size = (selected ? 30 : 22) * dpr;
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d")!;
      const pad = (selected ? 3.5 : 3) * dpr;
      ctx.lineJoin = "round";
      ctx.lineWidth = 2.2 * dpr;
      ctx.fillStyle = color;
      ctx.strokeStyle = "#fff";
      ctx.beginPath();
      if (shape === "triangle") {
        ctx.moveTo(size / 2, pad);
        ctx.lineTo(size - pad, size - pad * 0.85);
        ctx.lineTo(pad, size - pad * 0.85);
        ctx.closePath();
      } else {
        const r = 2.5 * dpr;
        const w = size - pad * 2;
        ctx.moveTo(pad + r, pad);
        ctx.arcTo(pad + w, pad, pad + w, pad + w, r);
        ctx.arcTo(pad + w, pad + w, pad, pad + w, r);
        ctx.arcTo(pad, pad + w, pad, pad, r);
        ctx.arcTo(pad, pad, pad + w, pad, r);
        ctx.closePath();
      }
      ctx.fill();
      ctx.stroke();
      return { width: size, height: size, data: new Uint8Array(ctx.getImageData(0, 0, size, size).data) };
    }

    function featuresFor(items: RadarItem[]) {
      return items.flatMap((item) => {
        const coords = pinFor(item);
        if (!coords) return [];
        const shape = item.nature === "planned" ? "square" : "triangle";
        const color = colors[toneOf(item.status)];
        const selected = state.selectedId === item.id;
        const icon = markerId(shape, color, selected);
        if (map && !map.hasImage(icon)) map.addImage(icon, drawMarker(shape, color, selected), { pixelRatio: 2 });
        return [{
          type: "Feature" as const,
          properties: { id: item.id, icon, rank: selected ? 3 : item.status === "active" ? 2 : item.status === "upcoming" ? 1 : 0 },
          geometry: { type: "Point" as const, coordinates: coords }
        }];
      });
    }

    async function ensureMap() {
      if (map) return map;
      if (mapInit) return mapInit;
      mapInit = (async () => {
        await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
        const container = document.querySelector("#radar-map");
        if (!container) return null;
        const mod = await import("maplibre-gl");
        maplibregl = mod.default;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        map = new maplibregl.Map({
          container,
          style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
          center: [8.2275, 46.8182],
          zoom: 7.2,
          attributionControl: false,
          antialias: false,
          fadeDuration: reduce ? 0 : 120,
          maxPitch: 0,
          pitchWithRotate: false,
          dragRotate: false,
          touchPitch: false,
          pixelRatio: Math.min(window.devicePixelRatio || 1, 1.5)
        });
        map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
        await new Promise<void>((resolve) => {
          const fail = window.setTimeout(resolve, 12_000);
          map.once("load", () => {
            window.clearTimeout(fail);
            resolve();
          });
        });
        if (!map.getSource("outages")) {
          map.addSource("outages", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
          map.addLayer({ id: "outages-hit", type: "circle", source: "outages", paint: { "circle-radius": 16, "circle-color": "#000", "circle-opacity": 0 } });
          map.addLayer({
            id: "outages-point",
            type: "symbol",
            source: "outages",
            layout: {
              "icon-image": ["get", "icon"],
              "icon-allow-overlap": true,
              "icon-ignore-placement": true,
              "symbol-sort-key": ["get", "rank"]
            }
          });
          const pick = (event: any) => {
            const id = Number(event.features?.[0]?.properties?.id);
            if (Number.isFinite(id)) selectItem(id, { openSheet: isMobile(), scroll: true });
          };
          map.on("click", "outages-hit", pick);
          map.on("click", "outages-point", pick);
          map.on("mouseenter", "outages-hit", () => { map.getCanvas().style.cursor = "pointer"; });
          map.on("mouseleave", "outages-hit", () => { map.getCanvas().style.cursor = ""; });
        }
        map.resize();
        mapReady = true;
        mapWrap.classList.add("is-ready");
        return map;
      })();
      return mapInit;
    }

    function syncPins(fit: boolean, recenter = false) {
      if (!map || !mapReady) return;
      const items = visibleItems();
      const features = featuresFor(items);
      map.getSource("outages")?.setData({ type: "FeatureCollection", features });
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (recenter && state.selectedId != null) {
        const selected = state.items.find((item) => item.id === state.selectedId);
        const coords = selected ? pinFor(selected) : null;
        if (coords) {
          map.easeTo({ center: coords, zoom: Math.max(map.getZoom(), 10), duration: reduce ? 0 : 280 });
          return;
        }
      }
      if (!fit || !features.length) return;
      const key = `${state.view}|${state.nature}|${state.query}|${features.length}`;
      if (key === lastFitKey) return;
      lastFitKey = key;
      const bounds = new maplibregl.LngLatBounds();
      for (const feature of features) bounds.extend(feature.geometry.coordinates);
      map.fitBounds(bounds, { padding: isMobile() ? 56 : 48, maxZoom: 10.5, duration: reduce ? 0 : 400 });
    }

    // ----------------------------------------------------------- render
    function escapeText(value: string) {
      return value.replace(/[&<>"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]!);
    }

    function renderControls() {
      const counts = viewCounts(state.items, state.nature, now());
      // With only the "now" subset loaded, planned/history counts come from the server.
      if (state.partial && state.embeddedCounts && !state.nature) {
        counts.planned = state.embeddedCounts.planned;
        counts.history = state.embeddedCounts.history;
      }
      document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
        const view = button.dataset.view as RadarView;
        button.setAttribute("aria-pressed", String(!searching() && view === state.view));
        const n = button.querySelector("[data-view-count]");
        if (n) n.textContent = String(counts[view]);
      });
      document.querySelectorAll<HTMLButtonElement>("[data-nature]").forEach((button) => {
        button.setAttribute("aria-pressed", String((button.dataset.nature ?? "") === state.nature));
      });
    }

    function renderList() {
      const t = now();
      const all = filtered();
      const shown = visibleItems(all);
      listEl.setAttribute("aria-busy", state.loading && !state.items.length ? "true" : "false");
      countEl.textContent = countLabel(all.length, copy);
      fabCountEl.textContent = String(all.length);
      moreBtn.hidden = shown.length >= all.length;
      moreBtn.textContent = copy.showMore.replace("{{count}}", String(Math.min(HISTORY_PAGE, all.length - shown.length)));
      if (state.error && !state.items.length) {
        listEl.innerHTML = `<div class="radar__empty" role="alert"><p>${escapeText(copy.empty.history)}</p><button type="button" class="radar__ghost" data-retry>↻</button></div>`;
        return;
      }
      if (!shown.length) {
        const message = searching() ? copy.empty.query.replace("{{query}}", state.query.trim()) : copy.empty[state.view];
        listEl.innerHTML = `<p class="radar__empty">${escapeText(message)}</p>`;
        return;
      }
      const focusedId = (document.activeElement as HTMLElement | null)?.closest?.<HTMLElement>("a.radar-item[data-id]")?.dataset.id;
      listEl.innerHTML = groupsHtml(groupItems(shown, state.view, t, copy, searching()), t, copy, state.selectedId);
      // Re-rendering replaces the rows; keep keyboard users where they were.
      if (focusedId) listEl.querySelector<HTMLElement>(`a.radar-item[data-id="${focusedId}"]`)?.focus({ preventScroll: true });
    }

    function renderNote() {
      if (!state.generatedAt) return;
      const date = new Date(state.generatedAt).toLocaleString(copy.dateLocale, { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Zurich" });
      noteEl.textContent = copy.asOf.replace("{{date}}", date);
    }

    function render(opts: { fit?: boolean } = {}) {
      renderControls();
      renderList();
      renderNote();
      syncPanelA11y();
      if (state.items.length) void ensureMap().then(() => syncPins(Boolean(opts.fit)));
    }

    // ------------------------------------------------------ interaction
    function syncPanelA11y() {
      fabEl.hidden = !isMobile() || state.drawerOpen;
      if (isMobile()) {
        panelEl.toggleAttribute("inert", !state.drawerOpen);
        panelEl.setAttribute("aria-hidden", state.drawerOpen ? "false" : "true");
        fabEl.setAttribute("aria-expanded", String(state.drawerOpen));
      } else {
        panelEl.removeAttribute("inert");
        panelEl.removeAttribute("aria-hidden");
      }
    }

    function setDrawer(open: boolean) {
      state.drawerOpen = open;
      panelEl.classList.toggle("is-open", open);
      document.body.classList.toggle("radar-drawer-open", open);
      syncPanelA11y();
      if (open) window.setTimeout(() => map?.resize(), 280);
    }

    function openSheet(item: RadarItem) {
      sheetBody.innerHTML = rowHtml(item, now(), copy).replace(/^<a /, "<div ").replace(/<\/a>$/, "</div>");
      sheetLink.href = eventHref(item, copy);
      sheetEl.hidden = false;
    }

    function closeSheet() {
      sheetEl.hidden = true;
    }

    function selectItem(id: number, opts: { openSheet?: boolean; scroll?: boolean } = {}) {
      state.selectedId = id;
      renderList();
      syncPins(false, true);
      const item = state.items.find((entry) => entry.id === id);
      if (item && opts.openSheet && isMobile()) {
        setDrawer(false);
        openSheet(item);
      }
      if (opts.scroll) listEl.querySelector<HTMLElement>(`[data-id="${id}"]`)?.scrollIntoView({ block: "nearest" });
    }

    function resetSelection() {
      state.selectedId = null;
      closeSheet();
      lastFitKey = "";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.addEventListener("click", () => {
      state.view = button.dataset.view as RadarView;
      if (state.partial && state.view !== "now") void loadIndex();
      state.limit = HISTORY_PAGE;
      if (searching()) {
        state.query = "";
        searchEl.value = "";
      }
      resetSelection();
      syncUrl();
      scrollEl.scrollTop = 0;
      render({ fit: true });
    }));

    document.querySelectorAll<HTMLButtonElement>("[data-nature]").forEach((button) => button.addEventListener("click", () => {
      state.nature = (button.dataset.nature ?? "") as RadarNature;
      resetSelection();
      syncUrl();
      render({ fit: true });
    }));

    let searchTimer = 0;
    searchEl.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      if (state.partial) void loadIndex();
      searchTimer = window.setTimeout(() => {
        state.query = searchEl.value;
        state.limit = HISTORY_PAGE;
        resetSelection();
        syncUrl();
        render({ fit: true });
      }, 120);
    });

    listEl.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-retry]")) {
        void loadIndex();
        return;
      }
      const row = target.closest<HTMLAnchorElement>("a.radar-item[data-id]");
      if (!row) return;
      const mouse = event as MouseEvent;
      if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.button === 1) return;
      const id = Number(row.dataset.id);
      if (!Number.isFinite(id)) return;
      // First click previews on the map, the second opens the report.
      if (!isMobile() && state.selectedId === id) return;
      event.preventDefault();
      selectItem(id, { openSheet: isMobile() });
    });

    moreBtn.addEventListener("click", () => {
      state.limit += HISTORY_PAGE;
      render();
    });

    $<HTMLButtonElement>("#radar-refresh").addEventListener("click", () => void loadIndex(true));
    $<HTMLButtonElement>("#radar-sheet-close").addEventListener("click", () => {
      closeSheet();
      state.selectedId = null;
      render();
    });
    $<HTMLButtonElement>("#radar-panel-close").addEventListener("click", () => setDrawer(false));
    fabEl.addEventListener("click", () => setDrawer(true));

    document.addEventListener("keydown", (event) => {
      const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement;
      if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        if (isMobile()) setDrawer(true);
        searchEl.focus();
        searchEl.select();
      } else if (event.key === "Escape") {
        if (typing && searchEl.value) {
          searchEl.value = "";
          state.query = "";
          syncUrl();
          render({ fit: true });
        } else if (state.selectedId != null) {
          resetSelection();
          render();
        } else if (state.drawerOpen) {
          setDrawer(false);
        }
      }
    });

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      if (!isMobile()) {
        setDrawer(false);
        closeSheet();
      }
      syncPanelA11y();
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => map?.resize(), 120);
    });

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      colors = TONE_COLOR();
      syncPins(false);
    });

    // ------------------------------------------------------------- data
    function applyIndex(payload: any) {
      state.items = fromIndex(payload);
      state.generatedAt = payload?.generatedAt ?? new Date().toISOString();
      state.partial = Boolean(payload?.partial);
      state.embeddedCounts = payload?.counts ?? null;
      state.error = false;
    }

    async function loadIndex(manual = false) {
      if (state.loading) return;
      state.loading = true;
      if (manual) document.querySelector("#radar-refresh")?.classList.add("is-spinning");
      try {
        const response = await fetch("/api/public/index.json", { headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error(String(response.status));
        applyIndex(await response.json());
      } catch {
        state.error = !state.items.length;
      } finally {
        state.loading = false;
        document.querySelector("#radar-refresh")?.classList.remove("is-spinning");
        render({ fit: manual });
      }
    }

    let embedded: any = null;
    try {
      embedded = JSON.parse(document.querySelector("#radar-index")?.textContent || "null");
    } catch {
      embedded = null;
    }
    if (embedded?.items) {
      applyIndex(embedded);
      render({ fit: true });
      // Load the full index for search and the other views once the page is idle
      // (or right away when the URL already asks for them).
      if (state.view !== "now" || searching()) void loadIndex();
      else {
        const idle = (window as any).requestIdleCallback ?? ((callback: () => void) => window.setTimeout(callback, 2500));
        idle(() => void loadIndex());
      }
    } else {
      void loadIndex();
    }
    void ensureMap().then(() => syncPins(true));

    window.setInterval(() => {
      if (document.visibilityState === "visible") void loadIndex();
    }, REFRESH_MS);
  </script>
</RadarLayout>

