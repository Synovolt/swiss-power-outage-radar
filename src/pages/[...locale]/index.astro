---
/**
 * Radar home. Answer first: live counters and a place search, then the list.
 * Desktop (≥ 960px): a scrolling side column (intro, filters, list) next to a
 * full-height map. Mobile: one scrolling page (intro, map, sticky filters, list).
 * The Worker (src/seo-home.ts) fills #radar-list, the counters and #radar-index;
 * the script below then searches and filters over the full public index.
 */
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../../layouts/RadarLayout.astro";
import "../../styles/radar-items.css";
import { homeJsonLd } from "../../seo-site";
import { renderHomeAbout } from "../../seo-home";
import {
  localeFromParam,
  localeStaticPaths,
  pathFor,
  radarViewCopy,
  t,
  type AppLocale
} from "../../i18n";
import { SITE_ORIGIN, absoluteUrl } from "../../public-url";
import Search from "@tabler/icons/outline/search.svg";
import X from "@tabler/icons/outline/x.svg";
import Refresh from "@tabler/icons/outline/refresh.svg";
import ChevronDown from "@tabler/icons/outline/chevron-down.svg";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
const homePath = pathFor({ kind: "home" }, locale);
const copy = radarViewCopy(locale);
const views = ["now", "planned", "history"] as const;
const u = (key: string, options?: Record<string, unknown>) => t(locale, `ui.home.${key}`, options);
---

<RadarLayout
  title={t(locale, "data.home.title")}
  description={t(locale, "site.description")}
  canonical={absoluteUrl(homePath, SITE_ORIGIN)}
  robots="index,follow,max-image-preview:large"
  shell="radar"
  activeNav="radar"
  locale={locale}
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />
  <link slot="head" rel="preconnect" href="https://vectortiles.geo.admin.ch" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://vectortiles.geo.admin.ch" />
  <script slot="head" type="application/ld+json" set:html={homeJsonLd(SITE_ORIGIN, locale)} />
  <script id="radar-i18n" type="application/json" set:html={JSON.stringify(copy).replace(/</g, "\\u003c")} />
  <script id="radar-index" type="application/json" set:html="null" />

  <section class="radar" data-radar>
    <div class="radar__map-wrap" data-loading-label={t(locale, "event.mapLoading")}>
      <div id="radar-map" class="radar__map" role="region" aria-label={t(locale, "home.mapAria")}></div>
      <div class="radar__legend" aria-hidden="true">
        <span><i data-tone="active"></i>{u("legendActive")}</span>
        <span><i data-tone="upcoming"></i>{u("legendPlanned")}</span>
        <span><i data-tone="ended"></i>{u("legendEnded")}</span>
      </div>
    </div>
    <div class="radar__side" id="radar-scroll">
      <header class="radar__intro">
        <div class="radar__meta">
          <span class="live-chip"><i aria-hidden="true"></i>{u("eyebrow")}</span>
          <span class="radar__updated">
            <span id="radar-note">{t(locale, "home.loading")}</span>
            <button type="button" id="radar-refresh" class="icon-btn" aria-label={t(locale, "home.refresh")} title={t(locale, "home.refresh")}>
              <Refresh aria-hidden="true" />
            </button>
          </span>
        </div>
        <h1 id="radar-title" class="radar__h1">{t(locale, "data.home.h1")}</h1>

        <div class="pulse" data-live>
          <button type="button" class="pulse__line pulse__line--active" data-go-view="now">
            <span class="pulse__n" data-live-count="active">–</span>
            <span class="pulse__label" data-live-label="active">{copy.tiles.activeOther}</span>
          </button>
          <button type="button" class="pulse__line pulse__line--upcoming" data-go-view="planned">
            <span class="pulse__n" data-live-count="upcoming">–</span>
            <span class="pulse__label" data-live-label="upcoming">{copy.tiles.plannedOther}</span>
            <span class="pulse__hint">{u("plannedHint")}</span>
          </button>
        </div>

        <form class="radar__search" role="search" action={homePath} method="get">
          <label class="radar__search-label" for="radar-search">{u("question")}</label>
          <div class="search-field">
            <Search class="search-field__icon" aria-hidden="true" />
            <input
              id="radar-search"
              name="q"
              type="search"
              placeholder={u("searchPlaceholder")}
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              aria-keyshortcuts="/"
              aria-controls="radar-list"
            />
            <kbd class="search-field__kbd" aria-hidden="true">/</kbd>
            <button type="button" id="radar-search-clear" class="icon-btn search-field__clear" aria-label={u("searchClear")} hidden>
              <X aria-hidden="true" />
            </button>
          </div>
        </form>
      </header>

      <div class="radar__toolbar">
        <div class="seg" role="group" aria-label={t(locale, "data.radar.viewsAria")}>
          {views.map((view) => (
            <button type="button" class="seg__btn" data-view={view} aria-pressed={view === "now" ? "true" : "false"}>
              {copy.views[view]}
            </button>
          ))}
        </div>
        <label class="select-pill">
          <span class="sr-only">{u("natureLabel")}</span>
          <select id="radar-nature">
            <option value="">{copy.natureAll}</option>
            <option value="unplanned">{copy.nature.unplanned}</option>
            <option value="planned">{copy.nature.planned}</option>
          </select>
          <ChevronDown class="select-pill__icon" aria-hidden="true" />
        </label>
      </div>

      <p id="radar-count" class="sr-only" aria-live="polite"></p>
      <div id="radar-list" class="radar__list" aria-busy="true" aria-labelledby="radar-title">
        <div class="radar-skel"></div><div class="radar-skel"></div><div class="radar-skel"></div>
      </div>
      <div class="radar__more-wrap">
        <button type="button" id="radar-more" class="btn-quiet" hidden>{t(locale, "home.loadMore")}</button>
      </div>
      <Fragment set:html={renderHomeAbout(locale)} />
      <p class="radar__disclaimer">{t(locale, "home.disclaimer")}</p>
    </div>

  </section>

  <script>
    import {
      HISTORY_PAGE,
      countLabel,
      eventHref,
      fromIndex,
      groupItems,
      groupsHtml,
      inView,
      limitRecent,
      matchesNature,
      matchesQuery,
      rowHtml,
      sortForView,
      toneOf,
      viewCounts,
      type RadarCopy,
      type RadarItem,
      type RadarNature,
      type RadarView
    } from "../../radar-view";
    import { SWISS_CANTONS } from "../../swiss-cantons";

    const copy = JSON.parse(document.querySelector("#radar-i18n")?.textContent || "{}") as RadarCopy;
    const VIEWS: RadarView[] = ["now", "planned", "history"];
    // Each poll is a Worker invocation (100k/day on the free plan): keep it rare.
    const REFRESH_MS = 600_000;
    const DESKTOP = window.matchMedia("(min-width: 960px)");

    const params = new URLSearchParams(location.search);
    const initialView = params.get("view") as RadarView | null;
    const initialNature = params.get("type") as RadarNature | null;

    const state = {
      items: [] as RadarItem[],
      generatedAt: null as string | null,
      view: (initialView && VIEWS.includes(initialView) ? initialView : "now") as RadarView,
      nature: (initialNature === "planned" || initialNature === "unplanned" ? initialNature : "") as RadarNature,
      query: params.get("q") ?? "",
      limit: HISTORY_PAGE,
      selectedId: null as number | null,
      hoverId: null as number | null,
      loading: false,
      error: false,
      /** True while only the embedded "now" subset is loaded. */
      partial: false,
      embeddedCounts: null as Record<RadarView, number> | null
    };

    const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
    const radarEl = $<HTMLElement>("[data-radar]");
    const listEl = $<HTMLElement>("#radar-list");
    const sideEl = $<HTMLElement>("#radar-scroll");
    const countEl = $<HTMLElement>("#radar-count");
    const noteEl = $<HTMLElement>("#radar-note");
    const moreBtn = $<HTMLButtonElement>("#radar-more");
    const searchEl = $<HTMLInputElement>("#radar-search");
    const clearBtn = $<HTMLButtonElement>("#radar-search-clear");
    const natureEl = $<HTMLSelectElement>("#radar-nature");
    const liveEl = $<HTMLElement>("[data-live]");
    const mapWrap = $<HTMLElement>(".radar__map-wrap");
    searchEl.value = state.query;
    natureEl.value = state.nature;
    clearBtn.hidden = !state.query;

    const CANTON_CENTROIDS = new Map(SWISS_CANTONS.map((canton) => [canton.code, canton.centroid]));
    const cssVar = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
    const palette = () => ({
      active: cssVar("--status-active", "#cb2a2f"),
      upcoming: cssVar("--status-upcoming", "#9a5a00"),
      ended: cssVar("--pin-ended", "#8b8f97"),
      ring: cssVar("--surface", "#ffffff"),
      ink: cssVar("--text", "#17181c")
    });

    const now = () => Date.now();
    const searching = () => state.query.trim().length > 0;
    const scroller = () => (DESKTOP.matches ? sideEl : document.scrollingElement ?? document.documentElement);

    function filtered(): RadarItem[] {
      const t = now();
      if (searching()) {
        return sortForView(state.items.filter((item) => matchesNature(item, state.nature) && matchesQuery(item, state.query)), "now");
      }
      return sortForView(state.items.filter((item) => inView(item, state.view, t) && matchesNature(item, state.nature)), state.view);
    }

    function visibleItems(all = filtered()): RadarItem[] {
      return state.view === "history" || searching() ? all.slice(0, state.limit) : all;
    }

    function pinFor(item: RadarItem): [number, number] | null {
      if (typeof item.lat === "number" && typeof item.lon === "number") return [item.lon, item.lat];
      const centroid = item.canton ? CANTON_CENTROIDS.get(item.canton) : null;
      if (!centroid) return null;
      return [centroid[1] + ((item.id % 13) - 6) * 0.012, centroid[0] + ((item.id % 17) - 8) * 0.012];
    }

    function syncUrl() {
      const next = new URLSearchParams();
      if (state.view !== "now") next.set("view", state.view);
      if (state.nature) next.set("type", state.nature);
      if (state.query.trim()) next.set("q", state.query.trim());
      const query = next.toString();
      history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
    }

    // ---------------------------------------------------------------- map
    let map: any = null;
    let maplibregl: any = null;
    let popup: any = null;
    let mapReady = false;
    let mapInit: Promise<any> | null = null;
    let lastFitKey = "";

    const toneKey = (item: RadarItem) => {
      const tone = toneOf(item.status);
      return tone === "active" || tone === "upcoming" ? tone : "ended";
    };

    function featuresFor(items: RadarItem[]) {
      return items.flatMap((item) => {
        const coords = pinFor(item);
        if (!coords) return [];
        const tone = toneKey(item);
        return [{
          type: "Feature" as const,
          id: item.id,
          properties: { id: item.id, tone, rank: tone === "active" ? 2 : tone === "upcoming" ? 1 : 0 },
          geometry: { type: "Point" as const, coordinates: coords }
        }];
      });
    }

    function applyPinPaint() {
      if (!map?.getLayer("outages-pin")) return;
      const c = palette();
      const color = ["match", ["get", "tone"], "active", c.active, "upcoming", c.upcoming, c.ended];
      map.setPaintProperty("outages-halo", "circle-color", c.active);
      map.setPaintProperty("outages-pin", "circle-color", color);
      map.setPaintProperty("outages-pin", "circle-stroke-color", c.ring);
      map.setPaintProperty("outages-focus", "circle-stroke-color", c.ink);
      map.setPaintProperty("outages-focus", "circle-color", color);
    }

    async function ensureMap() {
      if (map) return map;
      if (mapInit) return mapInit;
      mapInit = (async () => {
        await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
        const container = document.querySelector("#radar-map");
        if (!container) return null;
        const mod = await import("maplibre-gl");
        maplibregl = mod.default;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        map = new maplibregl.Map({
          container,
          style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
          center: DESKTOP.matches ? [7.4, 46.8182] : [8.2275, 46.8182],
          zoom: DESKTOP.matches ? 7.2 : 6.3,
          minZoom: 5.5,
          maxBounds: [[4.2, 44.6], [12.4, 48.6]],
          attributionControl: false,
          antialias: false,
          fadeDuration: reduce ? 0 : 120,
          maxPitch: 0,
          pitchWithRotate: false,
          dragRotate: false,
          touchPitch: false,
          // On the scrolling mobile page one finger scrolls the page, two move the map.
          cooperativeGestures: !DESKTOP.matches,
          pixelRatio: Math.min(window.devicePixelRatio || 1, 1.5)
        });
        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
        map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
        await new Promise<void>((resolve) => {
          const fail = window.setTimeout(resolve, 12_000);
          map.once("load", () => {
            window.clearTimeout(fail);
            resolve();
          });
        });
        if (!map.getSource("outages")) {
          map.addSource("outages", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
          map.addLayer({
            id: "outages-halo",
            type: "circle",
            source: "outages",
            filter: ["==", ["get", "tone"], "active"],
            paint: { "circle-radius": 15, "circle-opacity": 0.16, "circle-color": "#cb2a2f" }
          });
          map.addLayer({
            id: "outages-pin",
            type: "circle",
            source: "outages",
            layout: { "circle-sort-key": ["get", "rank"] },
            paint: {
              "circle-radius": ["match", ["get", "tone"], "active", 7, "upcoming", 6, 4.5],
              "circle-stroke-width": 2,
              "circle-color": "#cb2a2f",
              "circle-stroke-color": "#ffffff"
            }
          });
          map.addLayer({
            id: "outages-focus",
            type: "circle",
            source: "outages",
            filter: ["==", ["get", "id"], -1],
            paint: { "circle-radius": 9, "circle-stroke-width": 3, "circle-color": "#cb2a2f", "circle-stroke-color": "#17181c" }
          });
          applyPinPaint();
          const pick = (event: any) => {
            const id = Number(event.features?.[0]?.properties?.id);
            if (Number.isFinite(id)) selectItem(id, { popup: true, scroll: true });
          };
          map.on("click", "outages-pin", pick);
          map.on("mouseenter", "outages-pin", () => { map.getCanvas().style.cursor = "pointer"; });
          map.on("mouseleave", "outages-pin", () => { map.getCanvas().style.cursor = ""; });
        }
        map.resize();
        mapReady = true;
        mapWrap.classList.add("is-ready");
        return map;
      })();
      return mapInit;
    }

    function syncFocus() {
      if (!map?.getLayer("outages-focus")) return;
      const id = state.hoverId ?? state.selectedId ?? -1;
      map.setFilter("outages-focus", ["==", ["get", "id"], id]);
    }

    function syncPins(fit: boolean) {
      if (!map || !mapReady) return;
      const features = featuresFor(visibleItems());
      map.getSource("outages")?.setData({ type: "FeatureCollection", features });
      syncFocus();
      if (!fit || !features.length) return;
      const key = `${state.view}|${state.nature}|${state.query}|${features.length}`;
      if (key === lastFitKey) return;
      lastFitKey = key;
      const bounds = new maplibregl.LngLatBounds();
      for (const feature of features) bounds.extend(feature.geometry.coordinates);
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // On desktop the side panel floats over the left of the map: keep pins clear of it.
      const panel = DESKTOP.matches ? sideEl.getBoundingClientRect().right - mapWrap.getBoundingClientRect().left : 0;
      const padding = DESKTOP.matches ? { top: 72, bottom: 72, right: 88, left: Math.max(72, panel + 56) } : 32;
      map.fitBounds(bounds, { padding, maxZoom: 10.5, duration: reduce ? 0 : 400 });
    }

    function showPopup(item: RadarItem) {
      const coords = pinFor(item);
      if (!coords || !map) return;
      popup?.remove();
      const body = rowHtml(item, now(), copy).replace(/^<a /, "<div ").replace(/<\/a>$/, "</div>");
      popup = new maplibregl.Popup({ closeButton: true, closeOnClick: true, maxWidth: "min(23rem, calc(100vw - 2rem))", offset: 12, className: "radar-popup" })
        .setLngLat(coords)
        .setHTML(`${body}<a class="radar-popup__link" href="${eventHref(item, copy).replace(/"/g, "&quot;")}">${copy.openReport.replace(/</g, "&lt;")} →</a>`)
        .addTo(map);
      popup.on("close", () => {
        if (state.selectedId === item.id) {
          state.selectedId = null;
          markSelected();
          syncFocus();
        }
      });
    }

    // ----------------------------------------------------------- render
    function escapeText(value: string) {
      return value.replace(/[&<>"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char]!);
    }

    function renderLive() {
      const t = now();
      const active = state.items.filter((item) => item.status === "active" && matchesNature(item, "")).length;
      const counts = viewCounts(state.items, "", t);
      const planned = state.partial && state.embeddedCounts ? state.embeddedCounts.planned : counts.planned;
      const set = (selector: string, value: string) => {
        const el = liveEl.querySelector(selector);
        if (el) el.textContent = value;
      };
      set('[data-live-count="active"]', String(active));
      set('[data-live-count="upcoming"]', String(planned));
      set('[data-live-label="active"]', active === 1 ? copy.tiles.activeOne : copy.tiles.activeOther);
      set('[data-live-label="upcoming"]', planned === 1 ? copy.tiles.plannedOne : copy.tiles.plannedOther);
      liveEl.toggleAttribute("data-has-active", active > 0);
    }

    function renderControls() {
      document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
        button.setAttribute("aria-pressed", String(!searching() && button.dataset.view === state.view));
      });
      natureEl.value = state.nature;
      radarEl.dataset.view = searching() ? "search" : state.view;
    }

    function renderList() {
      const t = now();
      const all = filtered();
      const shown = visibleItems(all);
      listEl.setAttribute("aria-busy", state.loading && !state.items.length ? "true" : "false");
      countEl.textContent = countLabel(all.length, copy);
      moreBtn.hidden = shown.length >= all.length;
      moreBtn.textContent = copy.showMore.replace("{{count}}", String(Math.min(HISTORY_PAGE, all.length - shown.length)));
      if (state.error && !state.items.length) {
        listEl.innerHTML = `<div class="radar__empty" role="alert"><p>${escapeText(copy.empty.history)}</p><button type="button" class="btn-quiet" data-retry>↻</button></div>`;
        return;
      }
      if (!shown.length) {
        const message = searching() ? copy.empty.query.replace("{{query}}", state.query.trim()) : copy.empty[state.view];
        listEl.innerHTML = `<p class="radar__empty">${escapeText(message)}</p>`;
        return;
      }
      const focusedId = (document.activeElement as HTMLElement | null)?.closest?.<HTMLElement>("a.radar-item[data-id]")?.dataset.id;
      const groups = groupItems(shown, state.view, t, copy, searching());
      listEl.innerHTML = groupsHtml(state.view === "now" && !searching() ? limitRecent(groups) : groups, t, copy, state.selectedId);
      // Re-rendering replaces the rows; keep keyboard users where they were.
      if (focusedId) listEl.querySelector<HTMLElement>(`a.radar-item[data-id="${focusedId}"]`)?.focus({ preventScroll: true });
    }

    function renderNote() {
      if (!state.generatedAt) return;
      const date = new Date(state.generatedAt).toLocaleString(copy.dateLocale, { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Zurich" });
      noteEl.textContent = copy.asOf.replace("{{date}}", date);
    }

    function render(opts: { fit?: boolean } = {}) {
      renderLive();
      renderControls();
      renderList();
      renderNote();
      if (state.items.length) void ensureMap().then(() => syncPins(Boolean(opts.fit)));
    }

    function markSelected() {
      listEl.querySelectorAll<HTMLElement>("a.radar-item.is-selected").forEach((row) => {
        row.classList.remove("is-selected");
        row.removeAttribute("aria-current");
      });
      if (state.selectedId == null) return;
      const row = listEl.querySelector<HTMLElement>(`a.radar-item[data-id="${state.selectedId}"]`);
      row?.classList.add("is-selected");
      row?.setAttribute("aria-current", "true");
    }

    // ------------------------------------------------------ interaction
    function selectItem(id: number, opts: { popup?: boolean; scroll?: boolean } = {}) {
      state.selectedId = id;
      markSelected();
      syncFocus();
      const item = state.items.find((entry) => entry.id === id);
      if (item && opts.popup) showPopup(item);
      // Only the desktop side column scrolls to the row; on mobile the map stays in view.
      if (opts.scroll && DESKTOP.matches) listEl.querySelector<HTMLElement>(`[data-id="${id}"]`)?.scrollIntoView({ block: "nearest" });
    }

    function resetSelection() {
      state.selectedId = null;
      state.hoverId = null;
      popup?.remove();
      lastFitKey = "";
    }

    function scrollListTop() {
      const target = scroller();
      const top = DESKTOP.matches ? 0 : Math.max(0, listEl.getBoundingClientRect().top + window.scrollY - 140);
      if (!DESKTOP.matches && window.scrollY <= top) return;
      target.scrollTo({ top, behavior: "auto" });
    }

    function setView(view: RadarView) {
      state.view = view;
      if (state.partial && state.view !== "now") void loadIndex();
      state.limit = HISTORY_PAGE;
      if (searching()) {
        state.query = "";
        searchEl.value = "";
        clearBtn.hidden = true;
      }
      resetSelection();
      syncUrl();
      render({ fit: true });
      scrollListTop();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.addEventListener("click", () => setView(button.dataset.view as RadarView)));

    document.addEventListener("click", (event) => {
      const go = (event.target as HTMLElement).closest<HTMLElement>("[data-go-view]");
      if (!go) return;
      setView(go.dataset.goView as RadarView);
      if (!DESKTOP.matches) listEl.scrollIntoView({ block: "start", behavior: "smooth" });
    });

    natureEl.addEventListener("change", () => {
      state.nature = natureEl.value as RadarNature;
      resetSelection();
      syncUrl();
      render({ fit: true });
    });

    let searchTimer = 0;
    searchEl.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      clearBtn.hidden = !searchEl.value;
      if (state.partial) void loadIndex();
      searchTimer = window.setTimeout(() => {
        state.query = searchEl.value;
        state.limit = HISTORY_PAGE;
        resetSelection();
        syncUrl();
        render({ fit: true });
      }, 120);
    });

    searchEl.form?.addEventListener("submit", (event) => {
      event.preventDefault();
      searchEl.blur();
      listEl.scrollIntoView({ block: "start", behavior: "smooth" });
    });

    function clearSearch() {
      searchEl.value = "";
      clearBtn.hidden = true;
      state.query = "";
      resetSelection();
      syncUrl();
      render({ fit: true });
    }

    clearBtn.addEventListener("click", () => {
      clearSearch();
      searchEl.focus();
    });

    listEl.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-retry]")) void loadIndex(true);
    });

    // Hovering or focusing a row lights up its pin.
    const hoverRow = (event: Event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>("a.radar-item[data-id]");
      const id = row ? Number(row.dataset.id) : null;
      if (id === state.hoverId) return;
      state.hoverId = id;
      syncFocus();
    };
    listEl.addEventListener("mouseover", hoverRow);
    listEl.addEventListener("focusin", hoverRow);
    listEl.addEventListener("mouseleave", () => {
      state.hoverId = null;
      syncFocus();
    });

    moreBtn.addEventListener("click", () => {
      state.limit += HISTORY_PAGE;
      render();
    });

    $<HTMLButtonElement>("#radar-refresh").addEventListener("click", () => void loadIndex(true));

    document.addEventListener("keydown", (event) => {
      const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLSelectElement;
      if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        searchEl.focus();
        searchEl.select();
      } else if (event.key === "Escape") {
        if (event.target === searchEl && searchEl.value) clearSearch();
        else if (state.selectedId != null) {
          resetSelection();
          markSelected();
          syncFocus();
        }
      }
    });

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => map?.resize(), 120);
    });

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => applyPinPaint());

    // ------------------------------------------------------------- data
    function applyIndex(payload: any) {
      state.items = fromIndex(payload);
      state.generatedAt = payload?.generatedAt ?? new Date().toISOString();
      state.partial = Boolean(payload?.partial);
      state.embeddedCounts = payload?.counts ?? null;
      state.error = false;
    }

    async function loadIndex(manual = false) {
      if (state.loading) return;
      state.loading = true;
      if (manual) document.querySelector("#radar-refresh")?.classList.add("is-spinning");
      try {
        const response = await fetch("/api/public/index.json", { headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error(String(response.status));
        applyIndex(await response.json());
      } catch {
        state.error = !state.items.length;
      } finally {
        state.loading = false;
        document.querySelector("#radar-refresh")?.classList.remove("is-spinning");
        render({ fit: manual });
      }
    }

    let embedded: any = null;
    try {
      embedded = JSON.parse(document.querySelector("#radar-index")?.textContent || "null");
    } catch {
      embedded = null;
    }
    if (embedded?.items) {
      applyIndex(embedded);
      render({ fit: true });
      // Load the full index for search and the other views once the page is idle
      // (or right away when the URL already asks for them).
      if (state.view !== "now" || searching()) void loadIndex();
      else {
        const idle = (window as any).requestIdleCallback ?? ((callback: () => void) => window.setTimeout(callback, 2500));
        idle(() => void loadIndex());
      }
    } else {
      void loadIndex();
    }
    void ensureMap().then(() => syncPins(true));

    window.setInterval(() => {
      if (document.visibilityState === "visible") void loadIndex();
    }, REFRESH_MS);
  </script>
</RadarLayout>

