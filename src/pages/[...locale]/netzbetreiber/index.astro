---
import RadarLayout from "../../../layouts/RadarLayout.astro";
import { operatorProfileUrl, publicOperatorProfiles, sourceCategoryLabel } from "../../../operators";
import { SITE_ORIGIN, absoluteUrl } from "../../../public-url";
import { localeFromParam, localeStaticPaths, pathFor, t, type AppLocale } from "../../../i18n";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import PageCta from "@/components/app/PageCta.astro";
import "../../../styles/data-pages.css";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
const operators = publicOperatorProfiles();
const canonical = absoluteUrl(pathFor({ kind: "operators" }, locale), SITE_ORIGIN);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: t(locale, "operator.hubName"),
      description: t(locale, "operator.hubDescription"),
      inLanguage: locale === "en" ? "en" : `${locale}-CH`,
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: operators.length,
        itemListElement: operators.map((operator, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `${SITE_ORIGIN}${operatorProfileUrl(operator, locale)}`,
          name: operator.name
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t(locale, "site.breadcrumbHome"), item: `${SITE_ORIGIN}${pathFor({ kind: "home" }, locale)}` },
        { "@type": "ListItem", position: 2, name: t(locale, "operator.crumb"), item: canonical }
      ]
    }
  ]
};
---

<RadarLayout
  title={t(locale, "operator.hubTitle")}
  description={t(locale, "operator.hubDescription")}
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="operators"
  locale={locale}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="dp op-hub">
    <AppBreadcrumb locale={locale} items={[
      { href: pathFor({ kind: "home" }, locale), label: t(locale, "site.breadcrumbHomeShort") },
      { label: t(locale, "operator.crumb") }
    ]} />

    <header class="dp-head">
      <span class="dp-kicker">{t(locale, "operator.hubKicker")}</span>
      <h1>{t(locale, "operator.hubH1")}</h1>
      <p class="dp-lede">{t(locale, "operator.hubLede")}</p>
      <p class="dp-meta" id="operator-hub-live">{t(locale, "operator.hubPlaceholder")}</p>
    </header>

    <div class="op-list" id="operator-list" role="list">
      {operators.map((operator) => (
        <a href={operatorProfileUrl(operator, locale)} data-operator-slug={operator.slug} class="op-row op-row--none" role="listitem">
          <span class="op-row__dot" aria-hidden="true"></span>
          <span class="op-row__main">
            <span class="op-row__name">{operator.name}</span>
            <span class="op-row__area">{operator.area} · {sourceCategoryLabel(operator.sourceCategory, locale)}</span>
          </span>
        </a>
      ))}
    </div>

    <aside class="dp-help">
      <div>
        <p>{t(locale, "operator.hubMissing")}</p>
      </div>
      <a class="dp-btn" href="/ratgeber/netzbetreiber-finden/">{t(locale, "operator.findGuide")}<span aria-hidden="true">→</span></a>
    </aside>

    <PageCta
      title={t(locale, "operator.ctaTitle")}
      description={t(locale, "operator.ctaDescription")}
      href={pathFor({ kind: "home" }, locale)}
      label={t(locale, "operator.ctaLabel")}
    />
  </section>
</RadarLayout>
