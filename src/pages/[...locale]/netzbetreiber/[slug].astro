---
/**
 * Operator page. Reading order: live status (filled by the Worker into
 * #operator-live), official links, ElCom figures, what outage.ch does with the
 * source, what to do, FAQ. The static fallback below never claims a state.
 */
import RadarLayout from "../../../layouts/RadarLayout.astro";
import {
  operatorBySlug,
  operatorDefinition,
  operatorFaqs,
  operatorLanguageNote,
  operatorProfileUrl,
  operatorSourceExplanation,
  publicOperatorProfiles,
  relatedOperatorProfiles,
  sourceCategoryLabel
} from "../../../operators";
import { SITE_ORIGIN, absoluteUrl } from "../../../public-url";
import { operatorPageJsonLd, renderElcomFactsSection } from "../../../seo-operator-page";
import { localeFromParam, localeParam, pathFor, t, APP_LOCALES, type AppLocale } from "../../../i18n";
import AppBreadcrumb from "@/components/app/AppBreadcrumb.astro";
import PageCta from "@/components/app/PageCta.astro";
import "../../../styles/data-pages.css";

export function getStaticPaths() {
  return APP_LOCALES.flatMap((locale) =>
    publicOperatorProfiles().map((operator) => ({
      params: { locale: localeParam(locale), slug: operator.slug },
      props: { locale }
    }))
  );
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
const slug = Astro.params.slug as string;
const operator = operatorBySlug(slug);
if (!operator) {
  throw new Error(`Unknown operator ${slug}`);
}

const canonical = absoluteUrl(operatorProfileUrl(operator, locale), SITE_ORIGIN);
const definition = operatorDefinition(operator, locale);
const languageNote = operatorLanguageNote(operator, locale);
const sourceText = operatorSourceExplanation(operator, locale);
const faqs = operatorFaqs(operator, null, locale);
const related = relatedOperatorProfiles(operator, 4);
const elcomHtml = renderElcomFactsSection(operator, locale);
const jsonLd = operatorPageJsonLd(operator, null, SITE_ORIGIN, locale);
const steps = (["1", "2", "3"] as const).map((id) => ({
  title: t(locale, `operator.act${id}Title`),
  body: t(locale, `operator.act${id}Body`, { name: operator.name })
}));
---

<RadarLayout
  title={t(locale, "operator.pageTitle", { name: operator.name })}
  description={definition}
  canonical={canonical}
  robots="index,follow,max-image-preview:large"
  shell="content"
  activeNav="operators"
  locale={locale}
>
  <script slot="head" id="operator-jsonld" type="application/ld+json" set:html={jsonLd} />
  <article class="dp op-page">
    <AppBreadcrumb locale={locale} items={[
      { href: pathFor({ kind: "home" }, locale), label: t(locale, "site.breadcrumbHomeShort") },
      { href: pathFor({ kind: "operators" }, locale), label: t(locale, "operator.crumb") },
      { label: operator.name }
    ]} />

    <header class="dp-head">
      <span class="dp-kicker">{t(locale, "operator.kicker", { source: sourceCategoryLabel(operator.sourceCategory, locale) })}</span>
      <h1>{t(locale, "operator.pageH1", { name: operator.name })}</h1>
      <p class="dp-lede">{t(locale, "operator.lede", { name: operator.name, area: operator.area })}</p>
    </header>

    <section id="operator-live" class="op-live">
      <section class="dp-status dp-status--calm">
        <span class="dp-status__dot" aria-hidden="true"></span>
        <div class="dp-status__copy">
          <span class="dp-status__kicker">{t(locale, "operator.liveHeading")}</span>
          <p class="dp-status__detail">{t(locale, "operator.liveEmpty", { name: operator.name })}</p>
        </div>
        <div class="dp-status__actions">
          <a class="dp-btn dp-btn--primary" href={operator.officialUrl} target="_blank" rel="noreferrer">{t(locale, "data.common.official")}<span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </section>

    {elcomHtml && <Fragment set:html={elcomHtml} />}

    <section class="dp-card dp-prose" id="quelle">
      <header class="dp-card__head"><h2>{t(locale, "operator.sourceHeading")}</h2></header>
      <p class="dp-callout">{definition}</p>
      <p>{t(locale, "operator.sourceIntro", { name: operator.name, source: sourceCategoryLabel(operator.sourceCategory, locale), area: operator.area })}</p>
      <p>{sourceText}</p>
      {languageNote && <p>{languageNote}</p>}
      <p class="op-actions">
        <a class="dp-btn" href={operator.officialUrl} target="_blank" rel="noreferrer">{t(locale, "operator.officialOpen", { name: operator.name })}<span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <div class="dp-grid dp-grid--2">
      <section class="dp-card dp-prose" id="handeln">
        <header class="dp-card__head"><h2>{t(locale, "operator.actHeading")}</h2></header>
        <ol class="op-steps">
          {steps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <p class="op-actions">
          <a class="dp-btn" href="/ratgeber/stromausfall-was-tun/">{t(locale, "operator.helpGuide")}<span aria-hidden="true">→</span></a>
        </p>
      </section>

      <section class="dp-card dp-prose" id="radar">
        <header class="dp-card__head"><h2>{t(locale, "operator.radarHeading")}</h2></header>
        <p>{t(locale, "operator.radarP1", { name: operator.name, minutes: operator.checkMinutes })}</p>
        <p>{t(locale, "operator.radarP2", { name: operator.name })}</p>
        <p class="op-actions">
          <a class="dp-btn" href="/ratgeber/netzbetreiber-finden/">{t(locale, "operator.findGuide")}<span aria-hidden="true">→</span></a>
        </p>
      </section>
    </div>

    <section class="dp-card dp-faq" id="faq">
      <header class="dp-card__head"><h2>{t(locale, "operator.faqHeading", { name: operator.name })}</h2></header>
      <div id="operator-faq">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {related.length > 0 && (
      <section class="op-related" aria-labelledby="related-operators-heading">
        <h2 id="related-operators-heading" class="dp-section-title">{t(locale, "operator.relatedHeading")}</h2>
        <div class="op-list" role="list">
          {related.map((profile) => (
            <a href={operatorProfileUrl(profile, locale)} class="op-row op-row--none" role="listitem">
              <span class="op-row__dot" aria-hidden="true"></span>
              <span class="op-row__main">
                <span class="op-row__name">{profile.name}</span>
                <span class="op-row__area">{profile.area}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <PageCta
      title={t(locale, "operator.ctaReportsTitle")}
      description={t(locale, "operator.ctaReportsDescription")}
      href={pathFor({ kind: "home" }, locale)}
      label={t(locale, "operator.ctaReportsLabel")}
    />
  </article>
</RadarLayout>
