---
/**
 * Shell for Worker-rendered event pages. src/seo-event-page.ts fills #event-shell
 * (server-side, crawlable) and embeds the detail as #outage-event-data; this
 * script only adds the map, keeps "running for …" current and wires "share".
 */
import maplibreCss from "maplibre-gl/dist/maplibre-gl.css?url";
import RadarLayout from "../../../layouts/RadarLayout.astro";
import "../../../styles/event-brief.css";
import "../../../styles/radar-items.css";
import { localeFromParam, localeStaticPaths, t, type AppLocale } from "../../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: AppLocale = Astro.props.locale ?? localeFromParam(
  Array.isArray(Astro.params.locale) ? Astro.params.locale[0] : Astro.params.locale
);
---

<RadarLayout
  title={`${t(locale, "nature.unplannedKind")} | outage.ch`}
  description={t(locale, "site.description")}
  robots="noindex,follow"
  shell="content"
  activeNav="radar"
  locale={locale}
>
  <link slot="head" rel="stylesheet" href={maplibreCss} />
  <section class="detail-page">
    <div id="event-shell" aria-live="polite" aria-busy="true">
      <div class="detail-error" aria-label={t(locale, "event.loadingAria")}>
        <div class="shimmer" style="height:1rem;max-width:10rem;border-radius:6px"></div>
        <div class="shimmer" style="height:2.25rem;max-width:28rem;border-radius:8px"></div>
        <div class="shimmer" style="height:12rem;border-radius:12px"></div>
      </div>
    </div>
  </section>

  <script>
    type DetailResponse = {
      item: { url: string; status: string | null };
      map: null | {
        label: string;
        latitude: number;
        longitude: number;
        precision: "address" | "locality" | "municipality" | "district" | "region";
      };
    };

    const shell = document.querySelector<HTMLElement>("#event-shell")!;
    const zoomFor = (precision: NonNullable<DetailResponse["map"]>["precision"]) =>
      precision === "address" ? 14.2 : precision === "locality" ? 13 : precision === "municipality" ? 11.8 : 10.2;
    const cssVar = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    async function initializeMap(data: DetailResponse): Promise<void> {
      if (!data.map) return;
      const container = document.querySelector<HTMLElement>("#event-map");
      if (!container) return;
      const hero = container.closest<HTMLElement>(".event-hero");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let loaded = false;
      const markFailed = () => {
        if (loaded) return;
        hero?.classList.remove("map-loading");
        hero?.classList.add("map-failed");
      };
      const color = data.item.status === "active"
        ? cssVar("--status-active", "#cb2a2f")
        : data.item.status === "upcoming"
          ? cssVar("--status-upcoming", "#9a5a00")
          : "#8b8f97";
      try {
        const { default: maplibregl } = await import("maplibre-gl");
        const map = new maplibregl.Map({
          container,
          style: "https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json",
          center: [data.map.longitude, data.map.latitude],
          zoom: zoomFor(data.map.precision),
          interactive: false,
          attributionControl: false,
          fadeDuration: reduceMotion ? 0 : 350
        });
        map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-right");
        map.once("load", () => {
          loaded = true;
          hero?.classList.remove("map-loading", "map-failed");
          hero?.classList.add("map-ready");
          map.resize();
          map.addSource("outage-location", {
            type: "geojson",
            data: { type: "Feature", properties: {}, geometry: { type: "Point", coordinates: [data.map!.longitude, data.map!.latitude] } }
          });
          map.addLayer({ id: "outage-halo", type: "circle", source: "outage-location", paint: { "circle-radius": 26, "circle-color": color, "circle-opacity": 0.16 } });
          map.addLayer({
            id: "outage-point",
            type: "circle",
            source: "outage-location",
            paint: { "circle-radius": 8, "circle-color": color, "circle-stroke-color": "#ffffff", "circle-stroke-width": 3 }
          });
        });
        map.on("error", markFailed);
        window.setTimeout(markFailed, 8_000);
      } catch {
        markFailed();
      }
    }

    /** Keeps "running for …" and the time-window bar current while the page stays open. */
    function tickLive(): void {
      const now = Date.now();
      const since = shell.querySelector<HTMLElement>("[data-live-since]");
      if (since) {
        const start = Date.parse(since.dataset.liveSince ?? "");
        const units = JSON.parse(since.dataset.units ?? "{}") as { m: string; h: string; hm: string };
        if (Number.isFinite(start) && units.m) {
          const minutes = Math.max(1, Math.round((now - start) / 60_000));
          const hours = Math.floor(minutes / 60);
          const rest = minutes % 60;
          const duration = minutes < 60
            ? units.m.replace("{{m}}", String(minutes))
            : rest ? units.hm.replace("{{h}}", String(hours)).replace("{{m}}", String(rest)) : units.h.replace("{{h}}", String(hours));
          const [, ...tail] = since.textContent?.split(" · ") ?? [];
          since.textContent = [since.dataset.template?.replace("{{duration}}", duration) ?? "", ...tail].join(" · ");
        }
      }
      const windowEl = shell.querySelector<HTMLElement>(".ev-window");
      if (windowEl) {
        const start = Date.parse(windowEl.dataset.start ?? "");
        const end = Date.parse(windowEl.dataset.end ?? "");
        if (Number.isFinite(start) && Number.isFinite(end) && end > start) {
          const pct = `${Math.min(100, Math.max(0, ((now - start) / (end - start)) * 100)).toFixed(1)}%`;
          windowEl.querySelector<HTMLElement>(".ev-window__fill")?.style.setProperty("width", pct);
          windowEl.querySelector<HTMLElement>(".ev-window__now")?.style.setProperty("left", pct);
        }
      }
    }

    function wireShare(): void {
      const button = shell.querySelector<HTMLButtonElement>("[data-share]");
      if (!button) return;
      button.addEventListener("click", async () => {
        const url = location.href.split("#")[0];
        try {
          if (navigator.share && matchMedia("(pointer: coarse)").matches) {
            await navigator.share({ title: document.title, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          const label = button.querySelector("span");
          if (label) {
            const original = label.textContent;
            label.textContent = button.dataset.copied ?? "✓";
            window.setTimeout(() => { label.textContent = original; }, 2000);
          }
        } catch {
          /* dismissed share sheet or blocked clipboard: nothing to do */
        }
      });
    }

    async function load(): Promise<void> {
      const embedded = document.querySelector<HTMLScriptElement>("#outage-event-data")?.textContent;
      if (embedded) {
        const data = JSON.parse(embedded) as DetailResponse;
        shell.setAttribute("aria-busy", "false");
        wireShare();
        tickLive();
        window.setInterval(tickLive, 30_000);
        void initializeMap(data);
        return;
      }
      // Without server rendering (should not happen): go to the canonical event URL.
      const id = location.pathname.match(/-(\d+)\/?$/)?.[1];
      if (!id) throw new Error("not found");
      const response = await fetch(`/api/public/events/${id}`);
      if (!response.ok) throw new Error(String(response.status));
      const data = await response.json() as DetailResponse;
      if (data.item.url && data.item.url !== location.pathname) location.replace(data.item.url);
    }

    load().catch(() => {
      shell.innerHTML = `<div class="detail-error"><strong>${document.documentElement.lang.startsWith("fr") ? "Signalement indisponible" : document.documentElement.lang.startsWith("it") ? "Segnalazione non disponibile" : document.documentElement.lang.startsWith("en") ? "Report not available" : "Meldung nicht verfügbar"}</strong><a href="/">outage.ch</a></div>`;
      shell.setAttribute("aria-busy", "false");
    });
  </script>
</RadarLayout>
