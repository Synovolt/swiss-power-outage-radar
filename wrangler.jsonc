{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swiss-power-outage-radar",
  // Worker, D1 and R2 live in this account. Pinned because logins and API tokens
  // that see more than one account otherwise stop with
  // "More than one account available" in non-interactive deploys.
  "account_id": "bd37f4f688e8e9dba73cd6600aa00a70",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Homepage SSR, HTTPS redirects, and HTMLRewriter must run before static HTML.
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "outage.ch",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swiss-power-outage-radar",
      "database_id": "3e8f9daf-1164-4b9e-ab1f-b0ef8843270a",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Keys the edge cache per deploy (see publicCacheRequest in src/index.ts).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "outage-source-snapshots"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["alert@outage.ch"],
      "allowed_destination_addresses": ["pw@bimex.ch"]
    }
  ]
}
